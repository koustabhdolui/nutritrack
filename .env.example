# Local package registry credentials are only used by npm and must not be exposed to Vite.
# NPM_TOKEN=

# FatSecret credentials must stay server-side and are not used by this static build.
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=

# Supabase public frontend configuration.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=